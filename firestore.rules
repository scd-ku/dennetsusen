rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isTeacher(roomId) {
      return signedIn()
        && roomDoc(roomId).data.ownerUid == request.auth.uid;
    }

    match /rooms/{roomId} {
      // A room can be opened by code, but room enumeration is blocked.
      allow get: if signedIn();
      allow list: if false;

      // The anonymous Firebase user that creates the room becomes its teacher.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Room settings can only be changed by the teacher that created it.
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      match /notes/{noteId} {
        // Anyone who knows the room code and is anonymously authenticated
        // can read and add classroom data.
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.category == "未分類"
          && request.resource.data.likes == 0;

        // The teacher can update any field.
        // Students may only increment "likes" by exactly one.
        allow update: if isTeacher(roomId)
          || (
            signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"])
            && request.resource.data.likes == resource.data.likes + 1
          );

        // Only the teacher can delete data.
        allow delete: if isTeacher(roomId);
      }
    }
  }
}
